# Copy this file to .env (which git ignores) and fill in real values.
# Razorpay Dashboard -> Account & Settings -> API Keys (Test Mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret

# Shared token the Booking API uses to call this service
PAYMENT_INTERNAL_TOKEN=change-me
